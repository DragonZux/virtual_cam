# Sao chép thành view3d/.env (không commit). Đổi xong chạy lại `npm run dev` / `npm run preview`.
# Có thể truyền thẳng qua biến môi trường (ưu tiên hơn file này), vd. PowerShell:
#   $env:BACKEND_HOST="10.0.10.62"; $env:BACKEND_PORT="8033"; $env:BACKEND_PROTOCOL="https"; npm run dev

# Backend HICAS mà `npm run dev` / `npm run preview` chuyển /api (cả WebSocket) tới.
# Mặc định http://127.0.0.1:8030 (uvicorn khi phát triển). Docker / Jetson: BACKEND_PROTOCOL=https, BACKEND_PORT=8033
# (proxy chấp nhận chứng chỉ tự ký, trình duyệt không phải xác nhận).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8030
BACKEND_PROTOCOL=http

# Chỉ khi trình duyệt phải nối THẲNG WebSocket của máy chủ khác (bản build không đi qua proxy),
# vd. wss://10.0.10.62:8033/api/vision/ws. Để trống = /api/vision/ws cùng máy chủ đã mở trang.
# Đổi được lúc chạy ở Cài đặt của màn hình 3D hoặc bằng ?ws=... trên địa chỉ trang.
VITE_WS_URL=
