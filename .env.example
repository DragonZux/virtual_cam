# Biến cho docker compose (không commit). scripts/start_docker.bat → scripts/start.ps1 (Linux: scripts/start.sh) tự tạo .env và điền theo máy:
# LAN_IP, cổng trống, COMPOSE_FILE (GPU hay CPU), TORCH_INDEX, IMAGE_SIZE.

# IP LAN của máy chạy Docker (ipconfig) — điện thoại mở https://<LAN_IP>:8033
LAN_IP=
# Cổng trên máy host (đã chọn để không trùng các dự án khác)
WEB_PORT=8032
LAN_HTTPS_PORT=8033
# Bản PyTorch CUDA (cu128 / cu130…) và cạnh ảnh đưa vào YOLO
TORCH_INDEX=cu128
# Model YOLO: yolo26n-seg.pt (nhanh nhất) / yolo26m-seg.pt (cân bằng) / yolo26l-seg.pt (chính xác nhất, giống desktop/finger_select.py)
YOLO_MODEL=yolo26m-seg.pt
IMAGE_SIZE=640
# Laser đỏ: model riêng, không dùng ngưỡng confidence của đồ vật.
# Chuẩn bị một lần: python scripts/prepare_laser_model.py
LASER_MODEL=laser-advr-yolov5l6.torchscript
LASER_IMAGE_SIZE=1280
LASER_CONFIDENCE=0.55
# Bám chấm bằng vùng nhỏ; mất dấu sẽ quét lại toàn ảnh. 0 = tắt tối ưu này.
LASER_CROP_SIZE=384
# Thư mục trên máy host lưu ảnh / video tải lên để thử (start.ps1 mặc định %USERPROFILE%\Documents\virtual_cam, start.sh ~/Documents/virtual_cam)
UPLOAD_HOST_DIR=
