# Tuỳ chọn cho `docker compose up -d --build` (không bắt buộc, không commit): sao chép thành .env rồi sửa.
# Không có .env thì dùng các mặc định dưới đây.

# Cổng trên máy host (đã chọn để không trùng các dự án khác); vào bằng http://localhost:<cổng> hoặc http://<IP máy>:<cổng>
WEB_PORT=8032
# Bản PyTorch CUDA (cu128 / cu130…) và cạnh ảnh đưa vào YOLO
TORCH_INDEX=cu128
# Model YOLO: yolo26n-seg.pt (nhanh nhất) / yolo26m-seg.pt (cân bằng) / yolo26l-seg.pt (chính xác nhất)
YOLO_MODEL=yolo26m-seg.pt
IMAGE_SIZE=640
# Laser đỏ: model riêng, không dùng ngưỡng confidence của đồ vật (container tự xuất nếu models/ chưa có)
LASER_MODEL=laser-advr-yolov5l6.torchscript
LASER_IMAGE_SIZE=1280
LASER_CONFIDENCE=0.55
# Bám chấm bằng vùng nhỏ; mất dấu sẽ quét lại toàn ảnh. 0 = tắt tối ưu này.
LASER_CROP_SIZE=384
# Giới hạn mỗi file mô hình tải thêm trong Cài đặt (MB)
MAX_MODEL_MB=1024
