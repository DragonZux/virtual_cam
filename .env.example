# Biến cho docker compose (không commit). start.ps1 / start_docker.bat tự tạo .env và điền theo máy:
# LAN_IP, cổng trống, COMPOSE_FILE (GPU hay CPU), TORCH_INDEX, IMAGE_SIZE.

# IP LAN của máy chạy Docker (ipconfig) — điện thoại mở https://<LAN_IP>:8033
LAN_IP=
# Cổng trên máy host (đã chọn để không trùng các dự án khác)
WEB_PORT=8032
LAN_HTTPS_PORT=8033
# Bản PyTorch CUDA (cu128 / cu130…) và cạnh ảnh đưa vào YOLO
TORCH_INDEX=cu128
# Model YOLO: yolo26n-seg.pt (nhanh nhất) / yolo26m-seg.pt (cân bằng) / yolo26l-seg.pt (chính xác nhất, giống finger_select.py)
YOLO_MODEL=yolo26m-seg.pt
IMAGE_SIZE=640
