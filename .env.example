# Tuỳ chọn cho `docker compose up -d --build` (không bắt buộc, không commit): sao chép thành .env rồi sửa.
# Không có .env thì dùng các mặc định dưới đây.

# Cổng HTTPS trên máy host (đã chọn để không trùng các dự án khác): https://localhost:<cổng> hoặc https://<IP máy>:<cổng>
WEB_PORT=8033
# Không bắt buộc: IP máy ghi thêm vào chứng chỉ tự ký
# CERT_HOSTS=10.0.10.62
# Bản PyTorch CUDA (cu128 / cu130…) và cạnh ảnh đưa vào YOLO
TORCH_INDEX=cu128
# Jetson Orin / JetPack 6: dùng docker-compose.jetson.yml, không dùng torch cu128 của PC.
# Có thể dùng lại image HICAS Jetson đã kiểm tra CUDA để tránh tải lại thư viện:
# JETSON_BASE_IMAGE=virtual-cam:base-lan-https-20261001-085420
# Model YOLO: yolo26n-seg.pt (nhanh nhất) / yolo26m-seg.pt (cân bằng) / yolo26l-seg.pt (chính xác nhất)
YOLO_MODEL=yolo26m-seg.pt
# TensorRT: YOLO_MODEL=yolo26m-seg.engine (Ultralytics segmentation engine, GPU NVIDIA)
IMAGE_SIZE=640
# Laser đỏ: model riêng, không dùng ngưỡng confidence của đồ vật (container tự xuất nếu models/ chưa có)
LASER_MODEL=laser-advr-yolov5l6.torchscript
# TensorRT: LASER_MODEL=laser-advr-yolov5l6.engine (copy an engine built for this machine)
LASER_IMAGE_SIZE=1280
LASER_CONFIDENCE=0.55
# TorchScript: bám vùng nhỏ rồi tìm lại toàn ảnh. Engine ADVR cố định luôn chạy toàn ảnh.
LASER_CROP_SIZE=384
# Giới hạn mỗi file mô hình tải thêm trong Cài đặt (MB)
MAX_MODEL_MB=1024
