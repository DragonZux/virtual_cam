# Sao chép thành .env nếu cần đổi mặc định (không bắt buộc — chạy được ngay không cần .env).

# Cổng web trên máy này
PORT=8030
LOG_LEVEL=INFO

# Model (mặc định thư mục models/ ở gốc dự án)
# MODEL_DIR=../models
YOLO_MODEL=yolo26m-seg.pt        # cân bằng; yolo26n-seg.pt nhanh hơn, yolo26l-seg.pt chính xác hơn
HAND_MODEL=hand_landmarker.task
IMAGE_SIZE=640
DEVICE=auto                      # auto = GPU nếu có CUDA; cpu = ép chạy CPU
# Laser đỏ (chuẩn bị một lần: python docker/prepare_laser_model.py)
LASER_MODEL=laser-advr-yolov5l6.torchscript
LASER_IMAGE_SIZE=1280
LASER_CONFIDENCE=0.55
LASER_CROP_SIZE=384              # 0 = luôn quét toàn ảnh
MAX_MODEL_MB=1024                # giới hạn mỗi file tải thêm trong Cài đặt

# Mặc định nhận diện — client gửi targets / conf / tolerance kèm từng khung để đổi
DEFAULT_TARGETS=laptop,mouse,keyboard
DEFAULT_CONFIDENCE=0.80
DEFAULT_TOLERANCE_PX=30

# Origin của trang web khác được gọi API từ trình duyệt, cách nhau dấu phẩy (trống = không cho)
CORS_ORIGINS=
