# Sao chép thành .env nếu cần đổi mặc định (không bắt buộc — chạy được ngay không cần .env).

# Cổng web trên máy này và cổng HTTPS cho thiết bị khác trong mạng LAN (serve.py --lan)
PORT=8030
LAN_PORT=8031
LOG_LEVEL=INFO

# Model (mặc định lấy ở thư mục gốc dự án, dùng chung với finger_select.py)
# MODEL_DIR=..
YOLO_MODEL=yolo26m-seg.pt        # cân bằng; yolo26n-seg.pt nhanh hơn, yolo26l-seg.pt (finger_select.py) chính xác hơn
HAND_MODEL=hand_landmarker.task
IMAGE_SIZE=640
DEVICE=auto                      # auto = GPU nếu có CUDA; cpu = ép chạy CPU

# Ảnh / video tải lên để thử nhận diện (mặc định <thư mục người dùng>\Documents\virtual_cam)
# UPLOAD_DIR=C:\Users\<tên>\Documents\virtual_cam
MAX_UPLOAD_MB=500

# Mặc định nhận diện — mỗi trình duyệt tự chỉnh lại ở màn Cài đặt
DEFAULT_TARGETS=laptop,mouse,keyboard
DEFAULT_CONFIDENCE=0.80
DEFAULT_TOLERANCE_PX=30

# Chỉ cần khi mở frontend dev ở origin khác (vite đã proxy /api nên thường không cần sửa)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
