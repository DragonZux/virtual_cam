# Sao chép thành frontend/.env (không commit). Đổi xong chạy lại `npm run dev` / `npm run preview`.
# Có thể truyền thẳng qua biến môi trường (ưu tiên hơn file này), vd. PowerShell:
#   $env:BACKEND_HOST="10.0.9.81"; npm run preview

# Backend nhận diện mà `npm run dev` / `npm run preview` chuyển /api (cả WebSocket) tới.
# Mặc định http://127.0.0.1:8030. Docker / Jetson: BACKEND_PROTOCOL=https, BACKEND_PORT=8033 (chứng chỉ tự ký vẫn được).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8030
BACKEND_PROTOCOL=http

# Chỉ khi trình duyệt phải gọi THẲNG backend (bản build không đi qua proxy), vd. https://10.0.10.62:8033/api.
# Để trống = /api cùng origin. Gọi khác origin thì backend phải có origin của web trong CORS_ORIGINS
# và trình duyệt phải chấp nhận chứng chỉ của backend trước.
VITE_API_URL=
